{
  "name": "flowcheck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Graph-driven frontend testing: map a web app by walking it, judge every step with deterministic oracles.",
  "bin": { "flowcheck": "./src/cli.ts" },
  "scripts": {
    "fc": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
