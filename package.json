{
  "name": "flowcheck",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0",
  "type": "module",
  "description": "Graph-driven frontend testing: map a web app by walking it, judge every step with deterministic oracles.",
  "bin": {
    "flowcheck": "./src/cli.ts"
  },
  "scripts": {
    "fc": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.153.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite-plugin.d.ts",
      "default": "./src/vite-plugin.js"
    }
  }
}
