{
  "name": "uiscout",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0",
  "type": "module",
  "description": "Graph-driven frontend testing: map a web app by walking it, judge every step with deterministic oracles.",
  "bin": {
    "uiscout": "./dist/cli.js"
  },
  "scripts": {
    "scout": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp src/graph-view.html dist/",
    "prepare": "tsc -p tsconfig.build.json && cp src/graph-view.html dist/",
    "site": "node scripts/build-site.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.153.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "marked": "^18.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./vite": {
      "types": "./src/vite-plugin.d.ts",
      "default": "./src/vite-plugin.js"
    },
    "./webpack": {
      "types": "./src/webpack-loader.d.ts",
      "default": "./src/webpack-loader.js"
    },
    "./next": {
      "types": "./src/next-plugin.d.ts",
      "default": "./src/next-plugin.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./track": {
      "types": "./src/track.d.ts",
      "default": "./src/track.js"
    }
  },
  "files": [
    "dist",
    "src/vite-plugin.js",
    "src/vite-plugin.d.ts",
    "src/track.js",
    "src/track.d.ts"
  ]
}
